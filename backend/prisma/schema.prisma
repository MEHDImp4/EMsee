// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  email      String   @unique
  password   String
  full_name  String
  role       String   @default("student") // 'student', 'professor', 'admin'
  filiere    String?
  year       String?
  studentClass String?
  subjects   Json?
  avatar     String?
  banner     String?
  bio        String?
  location   String?
  created_at DateTime @default(now())

  posts          Post[]

  reposts        Repost[]
  likes          Like[]
  bookmarks      Bookmark[]
  pollVotes      PollVote[]
  postViews      PostView[]
  followedBy     Follow[]        @relation("following")
  following      Follow[]        @relation("follower")
  messages        Message[]             @relation("sender")
  notifications   Notification[]        @relation("recipient")
  sentNotifications Notification[]      @relation("actor")
  participants      ConversationParticipant[]
  
  // Community relations
  ownedCommunities Community[]     @relation("ownedCommunities")
  communityMemberships CommunityMember[]
  communityMessages CommunityMessage[]
  communityMessageReactions CommunityMessageReaction[]

  @@map("users")
}

model Notification {
  id          Int      @id @default(autoincrement())
  recipientId Int
  actorId     Int?
  type        NotificationType
  postId      Int?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient   User     @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?    @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)
  post        Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([actorId])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  MENTION
  LIKE
  REPOST
  FOLLOW
  SYSTEM
}

model Post {
  id              Int             @id @default(autoincrement())
  content         String          @db.Text
  userId          Int
  user            User            @relation(fields: [userId], references: [id])
  reposts         Repost[]
  likes           Like[]
  bookmarks       Bookmark[]
  hashtags        PostHashtag[]
  media           Media[]
  poll            Poll?
  views           Int             @default(0)
  postViews       PostView[]
  notifications   Notification[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  replyPermission ReplyPermission @default(EVERYONE)

  @@map("posts")
}

enum ReplyPermission {
  EVERYONE
  FOLLOWERS
  NO_ONE
}



model Repost {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, userId]) // Prevent duplicate reposts
  @@map("reposts")
}

model Like {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())


  
  @@unique([postId, userId])
  @@map("likes")
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("bookmarks")
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  follower    User     @relation("follower", fields: [followerId], references: [id])
  following   User     @relation("following", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("follows")
}

model Hashtag {
  id        Int              @id @default(autoincrement())
  name      String           @unique @db.VarChar(100)
  posts     PostHashtag[]
  createdAt DateTime         @default(now())

  @@index([name])
  @@map("hashtags")
}

model PostHashtag {
  id        Int      @id @default(autoincrement())
  postId    Int
  hashtagId Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, hashtagId])
  @@index([hashtagId])
  @@index([createdAt])
  @@map("post_hashtags")
}



model Media {
  id        Int       @id @default(autoincrement())
  postId    Int
  type      MediaType // 'image', 'code'
  url       String?   // For images
  code      String?   @db.Text // For code snippets
  language  String?   // Programming language for code
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([postId])
  @@map("media")
}

enum MediaType {
  IMAGE
  CODE
}

model Poll {
  id        Int          @id @default(autoincrement())
  postId    Int          @unique
  question  String       @db.Text
  options   PollOption[]
  votes     PollVote[]
  endsAt    DateTime?
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@map("polls")
}

model PollOption {
  id        Int        @id @default(autoincrement())
  pollId    Int
  text      String     @db.VarChar(255)
  votes     PollVote[]
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id        Int        @id @default(autoincrement())
  pollId    Int
  optionId  Int
  userId    Int
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([optionId])
  @@map("poll_votes")
}

model PostView {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([postId, userId])
  @@map("post_views")
}

model Conversation {
  id           Int                       @id @default(autoincrement())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  userId         Int
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_participants")
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String?      @db.Text // Optional now if sending only media
  read           Boolean      @default(false)
  readAt         DateTime?
  mediaUrl       String?
  mediaType      String?      // 'image', 'audio', 'video'
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model Community {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?  @db.Text
  icon        String?
  banner      String?
  privacy     CommunityPrivacy @default(PUBLIC)
  writeAccess CommunityWriteAccess @default(EVERYONE)
  ownerId     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation("ownedCommunities", fields: [ownerId], references: [id])
  members     CommunityMember[]
  messages    CommunityMessage[]

  @@map("communities")
}

model CommunityMember {
  id          Int      @id @default(autoincrement())
  communityId Int
  userId      Int
  role        CommunityRole @default(MEMBER)
  status      MemberStatus  @default(ACTIVE)
  joinedAt    DateTime      @default(now())

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
  @@map("community_members")
}

model CommunityMessage {
  id          Int      @id @default(autoincrement())
  communityId Int
  senderId    Int
  content     String?  @db.Text
  mediaUrl    String?
  mediaType   String?
  createdAt   DateTime @default(now())

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  sender      User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions   CommunityMessageReaction[]

  @@index([communityId])
  @@index([senderId])
  @@map("community_messages")
}

enum CommunityPrivacy {
  PUBLIC
  PRIVATE
}

enum CommunityWriteAccess {
  EVERYONE
  ADMINS_ONLY
}

enum CommunityRole {
  OWNER
  ADMIN
  MEMBER
  MODERATOR
}

enum MemberStatus {
  ACTIVE
  PENDING
  BLOCKED
}

model CommunityMessageReaction {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  emoji     String
  createdAt DateTime @default(now())

  message   CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji]) // Prevent duplicate reaction of same type by same user
  @@index([messageId])
  @@index([userId])
  @@map("community_message_reactions")
}
