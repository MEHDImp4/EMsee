# Production Environment Variables for Docker Stack
# Rename this file to .env on your server

# Database Configuration (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=change_this_to_secure_password
DB_NAME=projetjs_db

# Backend Configuration
JWT_SECRET=change_this_to_very_long_random_string
CLIENT_URL=https://yourdomain.com
NODE_ENV=production

# Frontend Build Variables (Used if building locally, but mostly here for reference)
# In production with pre-built images, these are baked in or handled by Nginx proxy
VITE_API_URL=/api
