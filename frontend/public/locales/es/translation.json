    "privacy_page": {
        "title": "Política de Privacidad",
        "last_updated": "Última actualización",
        "sections": {
            "collection": {
                "title": "Recopilación de Datos",
                "content": "Recopilamos información como su dirección de correo electrónico, nombre y datos académicos (carrera, año) para proporcionar y mejorar nuestros servicios."
            },
            "usage": {
                "title": "Uso de Datos",
                "content": "Sus datos se utilizan para personalizar su experiencia, facilitar la comunicación académica y enviarle actualizaciones importantes."
            },
            "cookies": {
                "title": "Cookies",
                "content": "Utilizamos cookies para mejorar la navegación, recordar sus preferencias y analizar el tráfico del sitio."
            },
            "security": {
                "title": "Seguridad",
                "content": "Implementamos medidas de seguridad de última generación para proteger su información personal contra el acceso no autorizado."
            },
            "rights": {
                "title": "Sus Derechos",
                "content": "Tiene derecho a acceder, corregir o eliminar sus datos personales en cualquier momento a través de la configuración de su cuenta."
            }
        }
    },
    "terms_page": {
        "title": "Términos de Servicio",
        "last_updated": "Última actualización",
        "sections": {
            "intro": {
                "title": "Introducción",
                "content": "Bienvenido a EMsee. Al acceder a nuestra plataforma, usted acepta estar sujeto a estos términos de servicio, todas las leyes y regulaciones aplicables, y acepta que es responsable de cumplir con las leyes locales aplicables."
            },
            "usage": {
                "title": "Licencia de Uso",
                "content": "Se concede permiso para descargar temporalmente una copia de los materiales (información o software) en el sitio web de EMsee para visualización transitoria personal y no comercial únicamente."
            },
            "content": {
                "title": "Contenido del Usuario",
                "content": "Usted conserva sus derechos sobre cualquier contenido que envíe, publique o muestre en o a través de nuestros servicios. Usted es responsable del uso de los servicios y de cualquier contenido que proporcione."
            },
            "termination": {
                "title": "Terminación",
                "content": "Podemos terminar o suspender su acceso inmediatamente, sin previo aviso ni responsabilidad, por cualquier motivo, incluyendo, sin limitación, si incumple los Términos."
            },
            "law": {
                "title": "Ley Aplicable",
                "content": "Estos términos y condiciones se rigen e interpretan de acuerdo con las leyes de Marruecos y usted se somete irrevocablemente a la jurisdicción exclusiva de los tribunales en ese Estado o ubicación."
            }
        }
    },
